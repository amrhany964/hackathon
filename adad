# 2. Function to find synonyms
def get_synonyms(word):
    synonyms = set()
    for syn in wordnet.synsets(word):
        for lemma in syn.lemmas():
            synonyms.add(lemma.name())
    return list(synonyms)

# 3. Data Augmentation for neutral class (replacing words with synonyms)
def augment_data_with_synonyms(text, neutral_threshold=0.8):
    words = text.split()
    augmented_text = words[:]
    for i, word in enumerate(words):
        if random.random() < neutral_threshold:  # Only augment neutral class
            synonyms = get_synonyms(word)
            if synonyms:
                new_word = random.choice(synonyms)
                augmented_text[i] = new_word
    return " ".join(augmented_text)

